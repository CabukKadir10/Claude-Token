{
  "name": "claude-token-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Local-only analytics for Claude Code session token usage and cost.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:static": "cross-env BUILD_STATIC=1 next build",
    "start": "next start",
